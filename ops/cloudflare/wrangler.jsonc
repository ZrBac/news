{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-refresh",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Production: manual refresh and scheduled recovery both run in Cloudflare.
    "MANUAL_ENABLED": "true",
    "WATCHDOG_ENABLED": "true",
    "SCHEDULE_ENABLED": "true",
  },
  // UTC: news at Beijing 09/11/13/15/17/19/21; outings also at 16.
  // Recovery checks stay in the daytime and only repair missed news slots.
  "triggers": { "crons": ["0 1,3,5,7,9,11,13 * * *", "0 8 * * *", "37 1-13 * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "NewsCoordinator" },
      { "name": "ADVICE_JOBS", "class_name": "OutingAdviceJob" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NewsCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["OutingAdviceJob"] },
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
